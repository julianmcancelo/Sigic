# ==============================================================================
# Variables de Entorno para Docker / Linux (SiGIC)
# ==============================================================================
# Si querés personalizar las credenciales, copiá este archivo a .env
# antes de ejecutar `docker compose up -d`.

# URL de la base de datos (por defecto apunta al servicio 'sigic-db' de docker-compose)
DATABASE_URL=postgres://sigic:sigic_password_segura_2026@sigic-db:5432/sigic_db
DB_SSL_INSECURE=1

# Clave secreta para generación de tokens JWT
JWT_SECRET=sigic_super_secreto_para_firma_jwt_produccion_2026_xyz

# URL pública con la que accederán los usuarios (ej: http://tuserver-ip:3000 o https://sigic.tudominio.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Configuración de Correo Electrónico (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_password_de_aplicacion
SMTP_FROM=no-reply@sigic.com.ar
