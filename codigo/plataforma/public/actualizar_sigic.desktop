[Desktop Entry]
Version=1.0
Type=Application
Name=Actualizar SiGIC
GenericName=Actualización Dinámica de SiGIC
Comment=Busca y aplica actualizaciones en caliente para SiGIC desde USB o Red
Exec=bash -c "/usr/local/bin/sigic-actualizar; echo ''; read -p 'Presione Enter para cerrar...' key"
Icon=system-software-update
Terminal=true
StartupNotify=true
Categories=System;Settings;
