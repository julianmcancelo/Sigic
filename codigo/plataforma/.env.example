# Base de datos exclusiva para este entorno.
DATABASE_URL="postgresql://usuario:password@host:5432/sigic?sslmode=require"

# Secreto aleatorio de al menos 32 caracteres. No reutilizar entre demo y producción.
JWT_SECRET="reemplazar-por-un-secreto-largo-y-aleatorio"

# Habilita los controles y tokens del expositor únicamente en la demo.
DEMO_MODE="false"
NEXT_PUBLIC_DEMO_MODE="false"

# SMTP (opcional para desarrollo; obligatorio para probar invitaciones y OTP reales).
EMAIL_HOST="smtp.ejemplo.com"
EMAIL_PORT="465"
EMAIL_SECURE="true"
EMAIL_USER="demo@sigic.com.ar"
EMAIL_PASS="reemplazar"
