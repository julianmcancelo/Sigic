<WixLocalization Culture="en-us" xmlns="http://schemas.microsoft.com/wix/2006/localization"><String Id="TauriLanguage">1033</String><String Id="TauriCodepage">1252</String><String Id="LaunchApp">Launch SiGIC Escritorio</String><String Id="DowngradeErrorMessage">A newer version of SiGIC Escritorio is already installed.</String><String Id="PathEnvVarFeature">Add the install location of the SiGIC Escritorio executable to the PATH system environment variable. This allows the SiGIC Escritorio executable to be called from any location.</String><String Id="InstallAppFeature">Installs SiGIC Escritorio.</String></WixLocalization>