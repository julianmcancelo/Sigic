#cloud-config
autoinstall:
  version: 1
  locale: es_AR.UTF-8
  keyboard:
    layout: es
  identity:
    hostname: sigic-appliance
    username: sigic
    password: "$6$rounds=4096$sigicsalt$7v1kK92W1Z3E9vP3wL1tYg0iQ5k0N3xQ2b1p6R7z8c3y4v5w6x7y8z9a0b1c2d3e4f5g6h7i8j9k0"
    realname: "SiGIC Appliance"
  ssh:
    install-server: true
    allow-pw: true
  packages:
    - docker.io
    - docker-compose-plugin
    - git
    - curl
    - openbox
    - xorg
    - xinit
    - nodm
    - chromium-browser
    - unclutter
    - hostapd
    - dnsmasq
    - wireless-tools
    - iw
    - avahi-daemon
  late-commands:
    # 1. Habilitar Docker y permisos para el usuario sigic
    - curtin in-target --target=/target -- systemctl enable docker
    - curtin in-target --target=/target -- usermod -aG docker sigic
    # 2. Descargar e instalar SiGIC en /opt/sigic
    - curtin in-target --target=/target -- git clone https://github.com/julianmcancelo/Sigic.git /opt/sigic
    - curtin in-target --target=/target -- chown -R sigic:sigic /opt/sigic
    # 3. Configurar servicio de inicio autónomo
    - curtin in-target --target=/target -- cp /opt/sigic/os-appliance/sigic.service /etc/systemd/system/sigic.service
    - curtin in-target --target=/target -- systemctl enable sigic.service
    # 4. Configurar punto de acceso Wi-Fi offline
    - curtin in-target --target=/target -- bash /opt/sigic/os-appliance/setup-hotspot.sh
    # 5. Configurar modo escritorio nativo SiGIC
    - curtin in-target --target=/target -- bash /opt/sigic/os-appliance/setup-kiosk.sh
    # 6. Personalización visual de marca
    - curtin in-target --target=/target -- bash /opt/sigic/os-appliance/custom-branding.sh
