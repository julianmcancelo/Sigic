[Unit]
Description=SiGIC - Servidor de la plataforma web
After=network.target sigic-db-init.service
Requires=sigic-db-init.service

[Service]
Type=simple
User=sigicweb
WorkingDirectory=/opt/sigic-web
EnvironmentFile=/etc/sigic/sigic.env
ExecStart=/usr/bin/node /opt/sigic-web/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
