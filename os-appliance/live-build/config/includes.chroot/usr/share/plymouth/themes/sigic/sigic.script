# ==============================================================================
# Script Plymouth para SiGIC OS — Beltrán 2026
# Gráficos pre-renderizados con máxima nitidez vectorial, orden y proporciones
# ==============================================================================

# 1. Color de Fondo Oficial (Azul Beltrán Noche Profundo #02070e)
Window.SetBackgroundTopColor(0.008, 0.027, 0.055);
Window.SetBackgroundBottomColor(0.008, 0.027, 0.055);

# 2. Dimensiones de la Pantalla
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# 3. Bloque Central Institucional (Logo + Tipografía + Resplandor de estudio)
center_image = Image("splash_center.png");
center_sprite = Sprite(center_image);

center_x = (screen_width - center_image.GetWidth()) / 2;
center_y = (screen_height - center_image.GetHeight()) / 2 - 25;

center_sprite.SetX(center_x);
center_sprite.SetY(center_y);
center_sprite.SetOpacity(1.0);

# 4. Barra de Progreso Animada (Track + Glow Bar)
track_image = Image("track.png");
track_sprite = Sprite(track_image);
track_x = (screen_width - track_image.GetWidth()) / 2;
track_y = center_y + center_image.GetHeight() + 15;
track_sprite.SetX(track_x);
track_sprite.SetY(track_y);
track_sprite.SetOpacity(0.9);

bar_image = Image("bar.png");
bar_sprite = Sprite(bar_image);
bar_sprite.SetY(track_y);
bar_sprite.SetOpacity(1.0);

# 5. Footer Institucional Pre-renderizado
footer_image = Image("footer.png");
footer_sprite = Sprite(footer_image);
footer_x = (screen_width - footer_image.GetWidth()) / 2;
footer_y = screen_height - 65;
footer_sprite.SetX(footer_x);
footer_sprite.SetY(footer_y);
footer_sprite.SetOpacity(0.85);

# 6. Animación Fluida en Ciclo de Refresco
progress = 0.0;
bar_travel = track_image.GetWidth() - bar_image.GetWidth();

fun refresh_callback () {
  progress += 0.038;
  pos_norm = 0.5 + 0.5 * Math.Sin(progress);
  bar_x = track_x + (pos_norm * bar_travel);
  bar_sprite.SetX(bar_x);
}

Plymouth.SetRefreshFunction(refresh_callback);
