#!/bin/bash
# Crea el rol y la base de datos de SiGIC (idempotente). Las tablas las crea la propia app.
set -e
for i in $(seq 1 60); do
  pg_isready -q -h localhost -p 5432 && break
  sleep 1
done
pg_isready -q -h localhost -p 5432 || { echo "PostgreSQL no responde"; exit 1; }

su postgres -c "psql -v ON_ERROR_STOP=1 -tAc \"SELECT 1 FROM pg_roles WHERE rolname='sigic'\"" | grep -q 1 || \
  su postgres -c "psql -v ON_ERROR_STOP=1 -c \"CREATE ROLE sigic LOGIN PASSWORD 'sigic'\""

su postgres -c "psql -tAc \"SELECT 1 FROM pg_database WHERE datname='sigic'\"" | grep -q 1 || \
  su postgres -c "createdb -O sigic sigic"

echo "Base de datos SiGIC lista."
