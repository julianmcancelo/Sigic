#!/bin/bash
# Lanzador de Acerca de SiGIC OS
# Prioriza la app nativa GTK3 y mantiene fallback a Chromium app con perfil aislado

if command -v python3 >/dev/null 2>&1 && python3 -c "import gi; gi.require_version('Gtk', '3.0'); from gi.repository import Gtk" >/dev/null 2>&1; then
  python3 /opt/sigic/acerca-de.py "$@" || exec chromium \
    --app="file:///opt/sigic/acerca-de.html" \
    --user-data-dir=/tmp/chromium-acerca-de \
    --window-size=740,600 \
    --no-first-run \
    --no-default-browser-check \
    --disable-translate \
    --disable-features=Translate
else
  exec chromium \
    --app="file:///opt/sigic/acerca-de.html" \
    --user-data-dir=/tmp/chromium-acerca-de \
    --window-size=740,600 \
    --no-first-run \
    --no-default-browser-check \
    --disable-translate \
    --disable-features=Translate
fi
