#!/bin/bash
# Se ejecuta al iniciar sesión: aplica el fondo de SiGIC y abre el navegador.
FONDO=/usr/share/backgrounds/sigic/fondo.png

# Fondo en todos los monitores/espacios de trabajo (esperar a que xfdesktop cree las propiedades)
(
  sleep 4
  for p in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep 'last-image$'); do
    xfconf-query -c xfce4-desktop -p "$p" -s "$FONDO" 2>/dev/null
    xfconf-query -c xfce4-desktop -p "${p%last-image}image-style" -s 5 2>/dev/null
  done
) &

exec chromium \
  --no-first-run --no-default-browser-check --noerrdialogs \
  --disable-infobars --disable-session-crashed-bubble \
  --password-store=basic --lang=es-AR --start-maximized \
  file:///opt/sigic/espera.html
