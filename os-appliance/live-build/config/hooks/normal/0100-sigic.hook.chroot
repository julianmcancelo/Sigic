#!/bin/bash
# Hook de construcción (dentro del chroot): personaliza el sistema de SiGIC OS.
set -e

# --- Idioma: español de Argentina ---
sed -i 's/^# *es_AR.UTF-8 UTF-8/es_AR.UTF-8 UTF-8/' /etc/locale.gen
grep -q '^es_AR.UTF-8 UTF-8' /etc/locale.gen || echo 'es_AR.UTF-8 UTF-8' >> /etc/locale.gen
locale-gen
update-locale LANG=es_AR.UTF-8 LANGUAGE=es_AR:es
echo "America/Argentina/Buenos_Aires" > /etc/timezone
ln -sf /usr/share/zoneinfo/America/Argentina/Buenos_Aires /etc/localtime

# --- Usuario de sistema para el servidor web ---
id sigicweb >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin sigicweb
chown -R sigicweb:sigicweb /opt/sigic-web
chmod +x /usr/local/bin/sigic-iniciar /usr/local/bin/sigic-acerca-de /usr/local/sbin/sigic-db-init 2>/dev/null || true
chmod 640 /etc/sigic/sigic.env
chgrp sigicweb /etc/sigic/sigic.env

# --- Servicios ---
systemctl enable postgresql || true
systemctl enable sigic-db-init.service
systemctl enable sigic-server.service

# --- Fondo de escritorio oficial SiGIC (reemplazar default xfce wallpapers) ---
mkdir -p /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml
cp -r /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/* /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/ 2>/dev/null || true
if [ -f /usr/share/backgrounds/sigic/fondo.png ]; then
  find /usr/share/backgrounds/xfce -type f -exec cp /usr/share/backgrounds/sigic/fondo.png {} + 2>/dev/null || true
  find /usr/share/images -name "*.png" -exec cp /usr/share/backgrounds/sigic/fondo.png {} + 2>/dev/null || true
  find /usr/share/images -name "*.svg" -exec cp /usr/share/backgrounds/sigic/fondo.png {} + 2>/dev/null || true
fi

# --- Iconos del sistema e identidad de escritorio ---
mkdir -p /usr/share/pixmaps \
         /usr/share/icons/hicolor/48x48/apps \
         /usr/share/icons/hicolor/128x128/apps \
         /usr/share/icons/hicolor/scalable/apps

if [ -f /opt/sigic/logo.png ]; then
  # Pixmaps directos
  cp /opt/sigic/logo.png /usr/share/pixmaps/sigic.png
  cp /opt/sigic/logo.png /usr/share/pixmaps/sigic-logo.png
  cp /opt/sigic/logo.png /usr/share/pixmaps/debian-logo.png
  cp /opt/sigic/logo.png /usr/share/pixmaps/xfce4_xicon.png
  cp /opt/sigic/logo.png /usr/share/pixmaps/xfce4_xicon1.png
  cp /opt/sigic/logo.png /usr/share/pixmaps/xfce4-panel-menu.png
  # Tema de iconos Hicolor
  cp /opt/sigic/logo.png /usr/share/icons/hicolor/48x48/apps/sigic.png
  cp /opt/sigic/logo.png /usr/share/icons/hicolor/128x128/apps/sigic.png
  cp /opt/sigic/logo.png /usr/share/icons/hicolor/scalable/apps/sigic.png
  cp /opt/sigic/logo.png /usr/share/icons/hicolor/48x48/apps/org.xfce.panel.applicationsmenu.png
  cp /opt/sigic/logo.png /usr/share/icons/hicolor/scalable/apps/org.xfce.panel.applicationsmenu.png
  gtk-update-icon-cache /usr/share/icons/hicolor 2>/dev/null || true
fi

# --- Accesos directos del escritorio ejecutables ---
chmod +x /etc/skel/Desktop/*.desktop 2>/dev/null || true

# --- Quitar bloqueo de pantalla (equipo de exposición sin contraseña) ---
apt-get purge -y light-locker xfce4-screensaver 2>/dev/null || true

# --- Identidad del sistema ---
sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="SiGIC OS (Instituto Tecnológico Beltrán)"/' /etc/os-release || true
cat > /etc/issue <<'EOF'
SiGIC OS - Instituto Tecnologico Beltran
EOF
echo "sigic-os" > /etc/hostname

# --- Tema de arranque Plymouth (si el tema es válido) ---
if [ -f /usr/share/plymouth/themes/sigic/sigic.plymouth ]; then
  plymouth-set-default-theme sigic 2>/dev/null || true
  update-initramfs -u 2>/dev/null || true
fi

# --- Limpieza ---
apt-get clean
rm -rf /var/lib/apt/lists/*
