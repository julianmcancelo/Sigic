# ==============================================================================
# Script Plymouth para SiGIC OS — Beltrán 2026
# Diseño oficial institucional con logo centrado, tipografía y barra animada
# ==============================================================================

# 1. Color de Fondo Oficial (Azul Beltrán Noche Profundo #02070e)
Window.SetBackgroundTopColor(0.008, 0.027, 0.055);
Window.SetBackgroundBottomColor(0.008, 0.027, 0.055);

# 2. Dimensiones de la Pantalla
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# 3. Logo Institucional SiGIC (180x180 centrado)
logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);

logo_x = (screen_width - logo_image.GetWidth()) / 2;
logo_y = (screen_height - logo_image.GetHeight()) / 2 - 50;

logo_sprite.SetX(logo_x);
logo_sprite.SetY(logo_y);
logo_sprite.SetOpacity(1.0);

# 4. Tipografía Institucional
title_image = Image.Text("SiGIC OS", 0.0, 0.90, 1.0, 1.0, "Sans Bold 20");
title_sprite = Sprite(title_image);
title_sprite.SetX((screen_width - title_image.GetWidth()) / 2);
title_sprite.SetY(logo_y + logo_image.GetHeight() + 16);
title_sprite.SetOpacity(1.0);

sub_image = Image.Text("INSTITUTO TECNOLÓGICO BELTRÁN", 0.50, 0.78, 0.92, 1.0, "Sans Bold 10");
sub_sprite = Sprite(sub_image);
sub_sprite.SetX((screen_width - sub_image.GetWidth()) / 2);
sub_sprite.SetY(logo_y + logo_image.GetHeight() + 44);
sub_sprite.SetOpacity(0.9);

status_image = Image.Text("Iniciando plataforma de colaciones y servicios...", 0.40, 0.60, 0.75, 1.0, "Sans 10");
status_sprite = Sprite(status_image);
status_sprite.SetX((screen_width - status_image.GetWidth()) / 2);
status_sprite.SetY(logo_y + logo_image.GetHeight() + 72);
status_sprite.SetOpacity(0.85);

# 5. Barra de Progreso Animada (Track + Glow Bar)
track_image = Image("track.png");
track_sprite = Sprite(track_image);
track_x = (screen_width - track_image.GetWidth()) / 2;
track_y = logo_y + logo_image.GetHeight() + 100;
track_sprite.SetX(track_x);
track_sprite.SetY(track_y);
track_sprite.SetOpacity(0.9);

bar_image = Image("bar.png");
bar_sprite = Sprite(bar_image);
bar_sprite.SetY(track_y);
bar_sprite.SetOpacity(1.0);

# 6. Pie de Página
foot_image = Image.Text("Práctica Profesionalizante 2026 · Cancelo · Alfonso · Contreras · Frassia · Santillán", 0.22, 0.38, 0.50, 1.0, "Sans 9");
foot_sprite = Sprite(foot_image);
foot_sprite.SetX((screen_width - foot_image.GetWidth()) / 2);
foot_sprite.SetY(screen_height - 35);
foot_sprite.SetOpacity(0.7);

# 7. Animación Fluida en Ciclo de Refresco
progress = 0.0;
bar_travel = track_image.GetWidth() - bar_image.GetWidth();

fun refresh_callback () {
  progress += 0.035;
  pos_norm = 0.5 + 0.5 * Math.Sin(progress);
  bar_x = track_x + (pos_norm * bar_travel);
  bar_sprite.SetX(bar_x);
  
  status_opacity = 0.65 + 0.35 * Math.Sin(progress * 1.5);
  status_sprite.SetOpacity(status_opacity);
}

Plymouth.SetRefreshFunction(refresh_callback);
