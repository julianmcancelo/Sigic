<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>SiGIC — Centro de Control</title>
<hta:application 
    id="sigicApp"
    applicationname="SiGIC"
    border="thin"
    borderstyle="normal"
    caption="yes"
    contextmenu="no"
    maximizebutton="no"
    minimizebutton="yes"
    navigable="no"
    scroll="no"
    selection="no"
    showintaskbar="yes"
    singleinstance="yes"
    sysmenu="yes"
    version="2.0"
    windowstate="normal"
/>
<style>
    * { box-sizing: border-box; }
    body {
        margin: 0;
        padding: 24px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        background: #f8fafc;
        color: #0f172a;
        user-select: none;
    }
    .header {
        text-align: center;
        margin-bottom: 20px;
    }
    .badge {
        display: inline-block;
        padding: 4px 12px;
        background: #e0f2fe;
        color: #0284c7;
        border-radius: 9999px;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        margin-bottom: 10px;
    }
    h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.02em;
    }
    p.sub {
        margin: 4px 0 0 0;
        font-size: 12px;
        color: #64748b;
    }
    .card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        padding: 18px;
        margin-bottom: 14px;
        box-shadow: 0 10px 15px -3px rgba(15, 23, 42, 0.05);
    }
    .btn {
        display: block;
        width: 100%;
        padding: 12px 16px;
        background: #0284c7;
        color: #ffffff;
        border: none;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        text-align: center;
        margin-bottom: 10px;
        outline: none;
    }
    .btn:hover {
        background: #0369a1;
    }
    .btn:active {
        transform: scale(0.98);
    }
    .btn-secondary {
        background: #f1f5f9;
        color: #334155;
        border: 1px solid #cbd5e1;
    }
    .btn-secondary:hover {
        background: #e2e8f0;
    }
    .btn-danger {
        background: #fff1f2;
        color: #be123c;
        border: 1px solid #fecdd3;
    }
    .btn-danger:hover {
        background: #ffe4e6;
    }
    .status-box {
        background: #f1f5f9;
        border-radius: 12px;
        padding: 10px;
        text-align: center;
        font-size: 11px;
        color: #64748b;
        font-weight: 600;
    }
    .footer {
        text-align: center;
        margin-top: 14px;
        font-size: 10px;
        font-weight: 700;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }
</style>
<script language="VBScript">
    Sub Window_OnLoad
        window.resizeTo 440, 520
        window.moveTo (screen.width - 440) / 2, (screen.height - 520) / 2
    End Sub

    Sub IniciarDocker
        Dim oShell
        Set oShell = CreateObject("WScript.Shell")
        document.getElementById("statusText").innerText = "Iniciando contenedores Docker..."
        oShell.Run "cmd /c INICIAR_SIGIC.bat", 1, False
    End Sub

    Sub DetenerDocker
        Dim oShell
        Set oShell = CreateObject("WScript.Shell")
        document.getElementById("statusText").innerText = "Deteniendo contenedores..."
        oShell.Run "cmd /c DETENER_SIGIC.bat", 1, False
    End Sub

    Sub AbrirNavegador
        Dim oShell
        Set oShell = CreateObject("WScript.Shell")
        oShell.Run "http://localhost:3000"
    End Sub

    Sub AbrirManual
        Dim oShell
        Set oShell = CreateObject("WScript.Shell")
        oShell.Run "documentacion\ESQUEMA_INTERACTIVO_BD.html"
    End Sub
</script>
</head>
<body>
    <div class="header">
        <div class="badge">Instituto Tecnológico Beltrán</div>
        <h1>SiGIC — Lanzador de Sistema</h1>
        <p class="sub">Centro de Control y Evaluación Oficial</p>
    </div>

    <div class="card">
        <button class="btn" onclick="IniciarDocker()">▶ Iniciar Plataforma SiGIC (Docker)</button>
        <button class="btn btn-secondary" onclick="AbrirNavegador()">🌐 Abrir en Navegador (localhost:3000)</button>
        <button class="btn btn-secondary" onclick="AbrirManual()">📊 Ver Diagrama Interactivo de BD</button>
        <button class="btn btn-danger" onclick="DetenerDocker()">⏹ Detener y Liberar Memoria</button>
    </div>

    <div class="status-box" id="statusText">
        Sistema listo para inicializar
    </div>

    <div class="footer">
        Tecnicatura Superior en Analista de Sistemas · v0.2.0
    </div>
</body>
</html>
