# Base de datos exclusiva para este entorno.
DATABASE_URL="postgresql://usuario:password@host:5432/sigic?sslmode=require"

# Secreto aleatorio de al menos 32 caracteres. No reutilizar entre demo y producción.
JWT_SECRET="reemplazar-por-un-secreto-largo-y-aleatorio"

# Resend (proveedor recomendado para producción)
RESEND_API_KEY="re_xxxxxxxxx"
EMAIL_FROM="SiGIC <no-responder@notificaciones.sigic.com.ar>"

# Carga datos de ejemplo únicamente en una base exclusiva de demostración.
# Los tokens bypass del expositor nunca se aceptan en el servidor.
DEMO_MODE="false"
NEXT_PUBLIC_DEMO_MODE="false"

# Obligatoria para crear la primera cuenta en producción. Quitar tras instalar.
SIGIC_SETUP_KEY=""

# Orígenes adicionales exactos, separados por comas; vacío permite solo el mismo origen.
SIGIC_ALLOWED_ORIGINS=""

# SMTP (opcional para desarrollo; obligatorio para probar invitaciones y OTP reales).
EMAIL_HOST="smtp.ejemplo.com"
EMAIL_PORT="465"
EMAIL_SECURE="true"
EMAIL_USER="demo@sigic.com.ar"
EMAIL_PASS="reemplazar"
